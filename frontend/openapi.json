          },
          "duration": {
            "type": "number",
            "minimum": 1
          },
          "videoLoops": {
            "type": "number",
            "minimum": 1,
            "default": 1
          }
        },
        "required": [
          "fileId",
          "position",
          "duration"
        ]
      },
      "ReorderPlaylistItemsDto": {
        "type": "object",
        "properties": {
          "itemIds": {
            "example": [5, 2, 7],
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "itemIds"
        ]
      },
      "CreateScreenDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "playerUrl": {
            "type": "string",
            "example": "http://localhost:5174",
            "description": "Adres aplikacji Player dla tego ekranu"
          }
        },
        "required": [
          "name"
        ]
      },
      "AssignPlaylistDto": {
        "type": "object",
        "properties": {
          "playlistId": {
            "type": "number",
            "minimum": 1,
            "example": 1,
            "description": "ID playlisty przypisywanej do ekranu"
          },
          "priority": {
            "type": "number",
            "minimum": 1,
            "example": 10,
            "description": "Priorytet przypisania"
          },
          "activeFrom": {
            "type": "string",
            "example": "2026-07-20T12:00:00Z",
            "description": "Data rozpoczęcia aktywności playlisty"
          },
          "activeTo": {
            "type": "string",
            "example": "2026-08-20T12:00:00Z",
            "description": "Data zakończenia aktywności playlisty"
          }
        },
        "required": [
          "playlistId"
        ]
      },
      "UpdateScreenPlaylistDto": {
        "type": "object",
        "properties": {
          "priority": {
            "type": "number"
          },
          "activeFrom": {
            "type": "string"
          },
          "activeTo": {
            "type": "string"
          }
        }
      },
      "UpdateScreenDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ekran hol główny",
            "description": "Nazwa ekranu"
          },
          "location": {
            "type": "string",
            "example": "Budynek A, parter",
            "description": "Lokalizacja ekranu"
          },
          "fallbackFileId": {
            "type": "number",
            "minimum": 1,
            "example": 15,
            "description": "ID pliku używanego jako fallback"
          },
          "playerUrl": {
            "type": "string",
            "example": "http://192.168.1.101:5174",
            "description": "Adres aplikacji Player dla tego ekranu"
          }
        }
      },
      "UpdateScreenStateDto": {
        "type": "object",
        "properties": {
          "currentPlaylistId": {
            "type": "number",
            "minimum": 1
          },
          "currentIndex": {
            "type": "number",
            "minimum": 1
          },
          "visible": {
            "type": "boolean"
          }
        },
        "required": [
          "currentPlaylistId",
          "currentIndex",
          "visible"
        ]
      },
      "RecordLogDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Playback started",
            "description": "Treść komunikatu logu"
          },
          "level": {
            "enum": [
              "INFO",
              "ERROR",
              "PLAYBACK"
            ],
            "type": "string",
            "example": "INFO",
            "description": "Poziom logu"
          }
        },
        "required": [
          "message"
        ]
      },
      "UpdateScreenHeartbeatDto": {
        "type": "object",
        "properties": {
          "playerUrl": {
            "type": "string",
            "format": "uri"
          },
          "visible": {
            "type": "boolean"
          }
        },
        "required": [
          "playerUrl",
          "visible"
        ]
      }
    }
  }
}