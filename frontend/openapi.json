      },
      "CreatePlaylistDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "repeatMode": {
            "enum": [
              "LOOP",
              "FALLBACK"
            ],
            "type": "string",
            "default": "LOOP"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdatePlaylistItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "position": {
            "type": "number"
          },
          "duration": {
            "type": "number"
          },
