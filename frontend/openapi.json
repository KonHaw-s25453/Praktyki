          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaylistItemEntity"
            }
          },
          "screenPlaylists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScreenPlaylistEntity"
            }
          },
          "screenStates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScreenStateEntity"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "revision",
          "repeatMode",
          "createdAt",
          "updatedAt",
          "items",
          "screenPlaylists",
          "screenStates"
        ]
      },
      "PlaylistItemEntity": {
        "type": "object",
