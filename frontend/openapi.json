      "url": ""
    }
  ],
  "components": {
    "schemas": {
      "CreateFileDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "originalName": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "size": {
            "type": "number",
            "minimum": 1
          },
          "checksum": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "filename",
          "originalName",
          "path",
          "mimeType",
          "size"
        ]
      },
      "ScreenPlaylistEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Unique identifier for the screen-playlist association"
          },
          "screenId": {
            "type": "number",
            "description": "Identifier for the associated screen"
          },
          "playlistId": {
            "type": "number",
            "description": "Identifier for the associated playlist"
          },
          "priority": {
            "type": "number",
            "description": "Priority of the screen-playlist association"
          },
          "activeFrom": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "description": "Start date and time when the playlist becomes active on the screen"
          },
          "activeTo": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "description": "End date and time when the playlist is no longer active on the screen"
          },
          "revision": {
            "type": "number",
            "description": "Revision number for the screen-playlist association"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "screen": {
            "$ref": "#/components/schemas/PlaylistEntity"
          },
          "playlist": {
            "$ref": "#/components/schemas/PlaylistEntity"
          }
        },
        "required": [
          "id",
          "screenId",
          "playlistId",
          "priority",
          "activeFrom",
          "activeTo",
          "revision",
          "createdAt",
          "updatedAt",
          "screen",
          "playlist"
        ]
      },
      "ScreenLogEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "screenId": {
            "type": "number",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "level": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "screenId",
          "message",
          "level",
          "createdAt"
        ]
      },
      "FileEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "filename": {
            "type": "string"
          },
          "originalName": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "nullable": true
          },
          "size": {
            "type": "number"
          },
          "checksum": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "playlistItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaylistItemEntity"
            }
          }
        },
        "required": [
          "id",
          "filename",
          "originalName",
          "path",
          "mimeType",
          "duration",
          "size",
          "checksum",
          "createdAt",
          "updatedAt",
          "playlistItems"
        ]
      },
      "ScreenEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "apiKey": {
            "type": "string",
            "nullable": true
          },
          "fallbackFileId": {
            "type": "number",
            "description": "ID pliku fallback"
          },
          "playerUrl": {
            "type": "string",
            "nullable": true
          },
          "lastSeen": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "isOnline": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "screenPlaylists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScreenPlaylistEntity"
            }
          },
          "screenLogs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScreenLogEntity"
            }
          },
          "state": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ScreenStateEntity"
              }
            ]
          },
          "fallbackFile": {
            "$ref": "#/components/schemas/FileEntity"
          }
        },
        "required": [
          "id",
          "name",
          "location",
          "apiKey",
          "fallbackFileId",
          "playerUrl",
          "lastSeen",
          "isOnline",
          "createdAt",
          "screenPlaylists",
          "screenLogs",
          "state",
          "fallbackFile"
        ]
      },
      "ScreenStateEntity": {
        "type": "object",
        "properties": {
          "screenId": {
            "type": "number"
          },
          "lastSync": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "lastPlaylistHash": {
            "type": "string",
            "nullable": true
          },
          "currentIndex": {
            "type": "number"
          },
          "visible": {
            "type": "boolean"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "screen": {
            "$ref": "#/components/schemas/ScreenEntity"
          },
          "currentPlaylist": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PlaylistEntity"
              }
            ]
          },
          "currentPlaylistId": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "screenId",
          "lastSync",
          "lastPlaylistHash",
          "currentIndex",
          "visible",
          "updatedAt",
          "screen",
          "currentPlaylist",
          "currentPlaylistId"
        ]
      },
      "PlaylistEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "revision": {
            "type": "number"
          },
          "repeatMode": {
            "type": "string",
